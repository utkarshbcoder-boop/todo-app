# Database (PostgreSQL)
POSTGRES_USER=todoapp
POSTGRES_PASSWORD=changeme
POSTGRES_DB=todoapp

# Server
PORT=3001
NODE_ENV=production

# JWT - Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=changeme

# Admin Panel - Generate hash with: node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
ADMIN_PANEL_PASSWORD_HASH=changeme
ADMIN_EMAILS=admin@example.com

# Google OAuth (optional)
GOOGLE_CLIENT_ID=

# Email (optional)
GMAIL_USER=
GMAIL_APP_PASSWORD=
